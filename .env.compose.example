# Docker Compose deployment example.
# Copy this file to .env before running docker compose. Do not reuse a local
# development .env that contains DATABASE_URL=storage/hlool-mail.db.

HLOOLMAIL_IMAGE=ghcr.io/hloolx/hloolmail:latest
GOPROXY=https://proxy.golang.org|https://goproxy.cn|direct
NPM_CONFIG_REGISTRY=https://registry.npmjs.org/

HTTP_PORT=3000
# Use 25 in production if your host/cloud allows inbound SMTP on TCP 25.
SMTP_PORT=2525

PUBLIC_BASE_URL=https://mail.example.com
# Public crawler indexing policy: none, landing, or docs. Recommended default is
# landing; use none during Safe Browsing recovery and docs after trust recovers.
PUBLIC_INDEXING=landing
MAIL_HOSTNAME=mail.example.com
EXPECTED_MX=mail.example.com
MX_STRICT=false

POSTGRES_DB=hloolmail
POSTGRES_USER=hloolmail
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password

# Optional: point the app at a managed PostgreSQL instance instead of the
# bundled postgres service. Leave empty to use the compose postgres service.
# When this is set, start only the app service with: docker compose up -d --no-deps app
HLOOLMAIL_DATABASE_URL=
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5

# Optional: set this to a mounted directory containing index.html and assets/
# when you want to override the frontend embedded in the app binary.
HLOOLMAIL_FRONTEND_DIST=

DEV_MODE=false
# Leave these empty to let the Install page generate and persist them in
# /app/storage/.env, or set two different strong random values yourself.
SESSION_SECRET=
INBOX_TOKEN_SECRET=
ADMIN_TOKEN=
ALLOW_LEGACY_ADMIN_TOKEN=false

MESSAGE_RETENTION_HOURS=24
AUDIT_LOG_RETENTION_DAYS=180
AUDIT_ACTIVITY_RETENTION_DAYS=30
METRICS_ENABLED=false
WEBHOOKS_ENABLED=true
DISABLE_PENDING_DOMAIN_DATA_PROTECTION=false
MAX_MESSAGE_BYTES=10485760
MAX_ATTACHMENT_BYTES=10485760
API_KEY_DEFAULT_DAILY_LIMIT=200000
ALLOW_API_KEY_QUERY_PARAM=false

GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URL=
GITHUB_OAUTH_ENABLED=false

LINUXDO_OAUTH_CLIENT_ID=
LINUXDO_OAUTH_CLIENT_SECRET=
LINUXDO_OAUTH_REDIRECT_URL=
LINUXDO_OAUTH_ENABLED=false
